{
  "name": "@joetjen/cooper",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "author": "Jan Oetjen <joetjen.riveting388@passmail.net> (http://joetjen.net)",
  "description": "Loads CASC config files -- a hierarchical, extensible config language with imports, variables, interpolation, loops, and consumer-registered resolvers/tags -- into native JS values, secrets redacted by default.",
  "homepage": "https://github.com/joetjen/node-cooper",
  "type": "module",
  "main": "./src/cooper.cjs",
  "types": "./types/cooper.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/cooper.d.ts",
        "default": "./src/cooper.js"
      },
      "require": {
        "types": "./types/cooper.d.cts",
        "default": "./src/cooper.cjs"
      },
      "default": "./src/cooper.cjs"
    }
  },
  "files": [
    "src",
    "types",
    "guides"
  ],
  "license": "Apache-2.0",
  "directories": {
    "src": "./src"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "auto-changelog": "^2.6.0",
    "chai": "^6.2.2",
    "fast-check": "^4.10.2",
    "mocha": "^12.0.3",
    "typedoc": "^0.28.20",
    "typescript": "~6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "test": "npx mocha --recursive test/",
    "autotest": "npx mocha --recursive --watch test/",
    "build:types": "rm -rf types && npx tsc -p tsconfig.build.json",
    "typecheck": "npx tsc --checkJs --noEmit && npm run build:types && npx tsc --noEmit -p test/types",
    "precommit": "npm run typecheck && npm test",
    "docs": "npx typedoc",
    "oracle": "cd ../cooper && mix run ../node-cooper/scripts/oracle.exs ../node-cooper/test/conformance/cases",
    "version": "npx auto-changelog --package --template keepachangelog && git add CHANGELOG.md",
    "prepack": "npm run build:types"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/joetjen/node-cooper.git"
  },
  "bugs": {
    "url": "https://github.com/joetjen/node-cooper/issues",
    "email": "joetjen.riveting388@passmail.net"
  },
  "keywords": [
    "casc",
    "cooper",
    "config",
    "configuration",
    "dotenv",
    "secrets"
  ]
}
